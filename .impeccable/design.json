      "refersTo": "tag",
      "description": "Marca o plano em destaque.",
      "html": "<div class=\"ds-wrap\"><span class=\"ds-tag\">Mais completa</span></div>",
      "css": ".ds-wrap{background:#01010d;color:#eeedfb;font-family:Archivo,system-ui,sans-serif;padding:24px}.ds-tag{display:inline-block;background:#88f9c0;color:#01010d;border-radius:999px;padding:6px 12px;font-size:0.6875rem;font-weight:700;text-transform:uppercase;letter-spacing:0.12em}"
    },
    {
      "name": "Navegação",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Barra fixa com logo, links em caixa alta espaçada e sublinhado mint que cresce.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-logo\" href=\"#\"><span class=\"ds-logo-name\">Bispo Studio<span class=\"ds-dot\">.</span></span><span class=\"ds-logo-sub\">Sites para impressão 3D</span></a><div class=\"ds-links\"><a href=\"#\">Lojas</a><a href=\"#\">Planos</a><a href=\"#\">Precifica 3D</a><a href=\"#\">Dúvidas</a></div></nav>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;gap:24px;height:72px;padding:0 24px;background:rgba(1,1,13,0.92);font-family:Archivo,system-ui,sans-serif}.ds-logo{display:grid;text-decoration:none}.ds-logo-name{font-weight:700;font-size:1.625rem;letter-spacing:-0.03em;line-height:1.1;color:#fff}.ds-dot{color:#88f9c0}.ds-logo-sub{font-size:0.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.2em;color:#e2dbff}.ds-links{display:flex;gap:32px}.ds-links a{position:relative;display:inline-flex;align-items:center;min-height:44px;font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;text-decoration:none;color:#fff}.ds-links a::after{content:'';position:absolute;left:0;right:0;bottom:8px;height:1.5px;background:#88f9c0;transform:scaleX(0);transform-origin:100% 50%;transition:transform 320ms cubic-bezier(0.23,1,0.32,1)}.ds-links a:hover::after{transform:scaleX(1);transform-origin:0 50%}.ds-links a:focus-visible{outline:3px solid #88f9c0;outline-offset:3px}"
    },
