      "html": "<div class=\"ds-wrap\"><h2 class=\"ds-title\"><span class=\"ds-b\">Planos</span><span class=\"ds-i\">e preços</span></h2></div>",
      "css": ".ds-wrap{background:#01010d;color:#eeedfb;font-family:Archivo,system-ui,sans-serif;padding:24px}.ds-title{display:flex;flex-direction:column;margin:0;font-weight:400}.ds-b{font-family:Anton,Impact,sans-serif;text-transform:uppercase;line-height:0.9;letter-spacing:-0.01em;color:#fff;font-size:6rem}.ds-i{font-family:'Bodoni Moda',Georgia,serif;font-style:italic;line-height:1;letter-spacing:-0.02em;color:#fff;font-size:3.5rem;margin-top:-0.06em}"
    },
    {
      "name": "Lista de linhas finas",
      "kind": "custom",
      "refersTo": "label",
      "description": "Garantias, provas e opções em linhas de 1px a 18%, valor em mint à direita.",
      "html": "<div class=\"ds-wrap\"><ul class=\"ds-lines\"><li><span>Pix e cartão pelo Mercado Pago</span><span>Bispo TCG</span></li><li><span>Frete calculado pelo CEP</span><span>Bispo TCG</span></li><li><span>Peça em 3D girando na página</span><span>As duas</span></li></ul></div>",
      "css": ".ds-wrap{background:#01010d;color:#eeedfb;font-family:Archivo,system-ui,sans-serif;padding:24px}.ds-lines{list-style:none;margin:0;padding:0;max-width:520px}.ds-lines li{display:flex;justify-content:space-between;gap:16px;padding:16px 0;border-top:1px solid rgba(238,237,251,0.18);font-size:0.875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em}.ds-lines li:last-child{border-bottom:1px solid rgba(238,237,251,0.18)}.ds-lines li span:last-child{color:#88f9c0;white-space:nowrap}"
    },
    {
