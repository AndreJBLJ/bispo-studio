      "html": "<div class=\"ds-wrap\"><a class=\"ds-pill-line\" href=\"#\">Ver a loja no ar <svg class=\"ds-arrow\" width=\"20\" height=\"12\" viewBox=\"0 0 20 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M0 6h18M13 1l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg></a></div>",
      "css": ".ds-wrap{background:#01010d;color:#eeedfb;font-family:Archivo,system-ui,sans-serif;padding:24px}.ds-pill-line{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:56px;padding:0 28px;border-radius:999px;font-family:Archivo,system-ui,sans-serif;font-weight:700;font-size:0.9375rem;text-transform:uppercase;letter-spacing:0.04em;text-decoration:none;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),background-color 220ms ease,color 220ms ease;cursor:pointer;background:transparent;color:#eeedfb;border:1.5px solid #88f9c0}.ds-pill-line:hover{background:#88f9c0;color:#01010d}.ds-pill-line:hover .ds-arrow{transform:translateX(5px)}.ds-pill-line:active{transform:scale(0.97)}.ds-pill-line:focus-visible{outline:3px solid #88f9c0;outline-offset:3px}.ds-arrow{transition:transform 260ms cubic-bezier(0.23,1,0.32,1)}"
    },
